{
  "name": "kde-uebersicht",
  "private": true,
  "version": "0.1.0",
  "description": "Übersicht-compatible desktop widgets for KDE Plasma (Wayland)",
  "scripts": {
    "build": "esbuild runtime/runtime.jsx --bundle --format=iife --minify --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=app/runtime/runtime.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint runtime tests"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0"
  },
  "type": "module"
}
