[Unit]
Description=Übersicht-style desktop widgets for KDE Plasma
Documentation=https://github.com/mpasternak/kde-uebersicht
PartOf=graphical-session.target
After=plasma-plasmashell.service
# only in Plasma sessions
ConditionEnvironment=XDG_CURRENT_DESKTOP=KDE

[Service]
ExecStart=/usr/bin/python3 -u @APP_DIR@/kde_uebersicht.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=plasma-workspace.target
